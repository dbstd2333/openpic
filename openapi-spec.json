  "info": {
    "title": "Picbed API",
    "description": "API for photo management and album organization",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username for authentication",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "Password for authentication",
            "example": "password123"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "username": {
            "type": "string",
            "description": "Username",
            "example": "admin"
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Success status",
            "example": true
          },
          "data": {
            "description": "User data",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserResponseDto"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "CreateAlbumDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Album name",
            "example": "Summer Vacation 2024"
          },
          "description": {
            "type": "string",
            "description": "Album description",
            "example": "Photos from our summer vacation"
          }
        },
        "required": [
          "name"
        ]
      },
      "DeletePhotosDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of photo IDs to delete",
            "example": [
              1,
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "MovePhotosDto": {
        "type": "object",
        "properties": {
          "photoIds": {
            "description": "Array of photo IDs to move",
            "example": [
              1,
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "albumId": {
            "type": "number",
            "description": "Target album ID",
            "example": 2
          }
        },
        "required": [
          "photoIds",
          "albumId"
        ]
      }
    }
  }
}