        ]
      }
    },
    "/photos/info/{id}": {
      "get": {
        "operationId": "PhotosController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Photo ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Photo metadata retrieved successfully"
          },
          "404": {
            "description": "Photo not found"
          },
          "500": {
            "description": "Internal server error"
          }
